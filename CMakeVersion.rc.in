1 VERSIONINFO
FILEVERSION @METADATA_VERSION_MAJOR@,@METADATA_VERSION_MINOR@,@METADATA_VERSION_PATCH@,0
PRODUCTVERSION @METADATA_VERSION_MAJOR@,@METADATA_VERSION_MINOR@,@METADATA_VERSION_PATCH@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x2L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "@METADATA_DESCRIPTION@"
            VALUE "FileVersion", "@CONFIGURE_LIBRARY_VERSION@.0"
            VALUE "InternalName", "@CONFIGURE_OUTPUT_NAME@"
            VALUE "OriginalFilename", "@CONFIGURE_DLL_NAME@.dll"
            VALUE "ProductName", "@METADATA_NAME@"
            VALUE "ProductVersion", "@METADATA_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
